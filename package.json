{
	"name": "cs-demo-cloud",
	"private": true,
	"type": "module",
	"packageManager": "pnpm@10.28.0",
	"engines": {
		"node": ">=22.18"
	},
	"scripts": {
		"dev": "pnpm db:migrate && pnpm --parallel --filter \"./apps/*\" dev",
		"build": "pnpm --filter \"./apps/*\" build",
		"check": "pnpm -r check",
		"lint": "prettier --check .",
		"format": "prettier --write .",
		"db:generate": "pnpm --filter @cs-demo-cloud/db generate",
		"db:migrate": "pnpm --filter @cs-demo-cloud/db migrate",
		"demos:import": "node apps/worker/src/import.ts",
		"test": "pnpm -r test"
	},
	"devDependencies": {
		"@types/node": "^22.18.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"typescript": "^6.0.3"
	}
}
